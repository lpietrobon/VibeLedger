new file mode 100644
index 0000000000000000000000000000000000000000..0f6617975e6820bdc3fb9c789b5cd0c551c3b0a9
--- /dev/null
+++ b/app/services/accounting.py
@@ -0,0 +1,65 @@
+"""Shared deterministic ledger expressions and comparable reporting periods.
+
+Amounts follow Plaid's sign convention: purchases positive, receipts negative.
+An unconfirmed transfer candidate remains in the ledger until reviewed.
+"""
+import calendar
+from datetime import date
+
+from sqlalchemy import case, select
+
+from app.models.models import Transaction, TransactionAnnotation, TransferPair
+
+
+def exclude_confirmed_transfers(query):
+    return query.filter(
+        ~Transaction.id.in_(select(TransferPair.txn_out_id).where(TransferPair.confirmed.is_(True))),
+        ~Transaction.id.in_(select(TransferPair.txn_in_id).where(TransferPair.confirmed.is_(True))),
+    )
+
+
+def posted_activity(query, include_transfers=False):
+    query = query.filter(Transaction.pending.is_(False))
+    return query if include_transfers else exclude_confirmed_transfers(query)
+
+
+def is_refund():
+    return (Transaction.amount < 0) & TransactionAnnotation.refund_status.in_(["confirmed", "likely"])
+
+
+def expense_amount():
+    return case((is_refund(), Transaction.amount), (Transaction.amount > 0, Transaction.amount), else_=0)
+
+
+def income_amount():
+    # COALESCE avoids SQL NULL treating an unannotated receipt as neither income
+    # nor a refund.
+    from sqlalchemy import func
+    return case(
+        ((Transaction.amount < 0) & ~func.coalesce(is_refund(), False), -Transaction.amount),
+        else_=0,
+    )
+
+
+def comparable_periods(today: date, granularity: str):
+    """Current start/end, previous start/comparable end/full end, inclusive.
+
+    Compare calendar dates, clipping short months and leap days. On the final
+    day of a month, compare both completed months in full.
+    """
+    if granularity == "yearly":
+        prior_year = today.year - 1
+        return (
+            date(today.year, 1, 1), today, date(prior_year, 1, 1),
+            date(prior_year, today.month, min(today.day, calendar.monthrange(prior_year, today.month)[1])),
+            date(prior_year, 12, 31),
+        )
+    if granularity != "monthly":
+        raise ValueError("granularity must be monthly or yearly")
+    year, month = (today.year, today.month - 1) if today.month > 1 else (today.year - 1, 12)
+    last = calendar.monthrange(year, month)[1]
+    complete = today.day == calendar.monthrange(today.year, today.month)[1]
+    return (
+        date(today.year, today.month, 1), today, date(year, month, 1),
+        date(year, month, last if complete else min(today.day, last)), date(year, month, last),
+    )
