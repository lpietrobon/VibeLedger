+"""Money conservation and drill-down parity across linked checking/card/Venmo.
+
+These are synthetic ledger examples, independent of Plaid and the live clock.
+"""
+from datetime import date
+
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy import text
+
+from app.api import routes
+from app.db.session import SessionLocal, engine
+from app.main import app
+from app.models.models import Account, Item, Transaction, TransactionAnnotation, TransferPair
+from app.services.accounting import comparable_periods
+from app.services.security import encrypt_token
+from tests.conftest import AUTH_HEADERS
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    def set_date(value):
+        class FixedDate(date):
+            @classmethod
+            def today(cls):
+                return value
+        monkeypatch.setattr(routes, "date", FixedDate)
+    set_date(date(2024, 3, 15))
+    return set_date
+
+
+def _seed(rows):
+    """Rows: (id, account name, date, amount, category, pending)."""
+    with SessionLocal() as db:
+        item = Item(plaid_item_id="integrity-item", access_token_encrypted=encrypt_token("test"))
+        db.add(item)
+        db.flush()
+        accounts = {}
+        for name in {row[1] for row in rows}:
+            account = Account(plaid_account_id=name, item_id=item.id, name=name)
+            db.add(account)
+            db.flush()
+            accounts[name] = account.id
+        ids = {}
+        for name, account, day, amount, category, pending in rows:
+            tx = Transaction(plaid_transaction_id=name, account_id=accounts[account],
+                             item_id=item.id, date=day, amount=amount, name=name,
+                             plaid_category_primary=category, pending=pending)
+            db.add(tx)
+            db.flush()
+            ids[name] = tx.id
+        db.commit()
+        return ids
+
+
+def _get(client, path, **params):
+    response = client.get(path, params=params, headers=AUTH_HEADERS)
+    assert response.status_code == 200, response.text
+    return response.json()
+
+
+def test_posted_ledger_matches_every_chart_and_drilldown_before_and_after_confirmation(clock):
+    day = date(2024, 3, 5)
+    ids = _seed([
+        ("salary", "checking", day, -2000, "INCOME", False),
+        ("dinner", "card", day, 120, "FOOD_AND_DRINK", False),
+        ("card payment out", "checking", day, 200, "TRANSFER_OUT", False),
+        ("card payment in", "card", day, -200, "TRANSFER_IN", False),
+        ("funding out", "checking", day, 75, "TRANSFER_OUT", False),
+        ("funding in", "venmo", day, -75, "TRANSFER_IN", False),
+        ("venmo spend", "venmo", day, 25, "FOOD_AND_DRINK", False),
+        ("refund", "card", day, -40, "FOOD_AND_DRINK", False),
+        ("pending dinner", "card", day, 999, "FOOD_AND_DRINK", True),
+        ("pending income", "checking", day, -500, "INCOME", True),
+    ])
+    with SessionLocal() as db:
+        db.add(TransferPair(txn_out_id=ids["funding out"], txn_in_id=ids["funding in"], confirmed=True))
+        candidate = TransferPair(txn_out_id=ids["card payment out"], txn_in_id=ids["card payment in"], confirmed=False)
+        db.add(candidate)
+        db.add(TransactionAnnotation(transaction_id=ids["refund"], refund_status="confirmed"))
+        db.commit()
+        candidate_id = candidate.id
+
+    with TestClient(app) as client:
+        for confirmed, expected_spend, expected_income in [(False, 305, 2200), (True, 105, 2000)]:
+            if confirmed:
+                response = client.post(f"/transfers/{candidate_id}/confirm", headers=AUTH_HEADERS)
+                assert response.status_code == 200
+            monthly = _get(client, "/analytics/monthly-spend")
+            categories = _get(client, "/analytics/category-spend")
+            cash = _get(client, "/analytics/cashflow-trend")[0]
+            overview = _get(client, "/analytics/overview")
+            summary = _get(client, "/analytics/spending-summary")
+            pace = _get(client, "/analytics/cumulative-spend")
+            daily = _get(client, "/analytics/daily-spend", year=2024)
+            sankey = _get(client, "/analytics/cashflow-sankey")
+            drilldown = _get(client, "/transactions", q="is:spend from:2024-03 to:2024-03")
+            all_rows = {t["id"]: t for t in _get(client, "/transactions")["items"]}
+
+            assert monthly == [{"month": "2024-03", "spend": expected_spend}]
+            assert sum(row["spend"] for row in categories) == expected_spend
+            assert cash == {"month": "2024-03", "expenses": expected_spend,
+                            "income": expected_income, "net": 1895}
+            assert overview["month_spend"] == summary["total"] == expected_spend
+            assert overview["month_income"] == expected_income
+            assert pace[14]["current"] == expected_spend
+            assert pace[15]["current"] is None
+            assert sum(row["amount"] for row in daily["days"]) == expected_spend
+            assert sankey["total_spend"] == expected_spend
+            assert sum(row["amount"] for row in drilldown["items"]) == expected_spend
+            assert all_rows[ids["card payment out"]]["is_transfer"] is confirmed
+            assert all_rows[ids["card payment out"]]["is_transfer_candidate"] is not confirmed
+            assert all_rows[ids["card payment out"]]["transfer_pair_id"] == candidate_id
+            visible = {row["id"] for row in _get(client, "/transactions", q="is:not-transfer")["items"]}
+            assert (ids["card payment out"] not in visible) is confirmed
+            assert ids["pending dinner"] in all_rows  # visible, just not recognized spending
+            with engine.connect() as connection:
+                spend, income = connection.execute(text(
+                    "SELECT SUM(expense_amount), SUM(income_amount) FROM effective_transactions"
+                )).one()
+                assert (spend, income) == (expected_spend, expected_income)
+
+        # Raw transfer mode still cannot count authorizations as posted activity.
+        assert _get(client, "/analytics/monthly-spend", include_transfers=True)[0]["spend"] == 380
+
+
+def test_current_periods_do_not_anchor_to_last_transaction_or_compare_future_spend(clock):
+    _seed([
+        ("current", "checking", date(2024, 3, 5), 100, "FOOD_AND_DRINK", False),
+        ("previous early", "checking", date(2024, 2, 10), 80, "FOOD_AND_DRINK", False),
+        ("previous late", "checking", date(2024, 2, 20), 900, "FOOD_AND_DRINK", False),
+        ("prior year early", "checking", date(2023, 3, 10), 60, "FOOD_AND_DRINK", False),
+        ("prior year late", "checking", date(2023, 3, 25), 700, "FOOD_AND_DRINK", False),
+        ("future", "checking", date(2024, 12, 1), 5000, "FOOD_AND_DRINK", False),
+    ])
+    with TestClient(app) as client:
+        summary = _get(client, "/analytics/spending-summary")
+        overview = _get(client, "/analytics/overview")
+        assert summary["total"] == overview["month_spend"] == 100
+        assert summary["previous_total"] == overview["previous_month_spend"] == 80
+        assert summary["previous_full_total"] == overview["previous_month_full_spend"] == 980
+        assert summary["previous_period_end"] == "2024-02-15"
+        yearly = _get(client, "/analytics/spending-summary", granularity="yearly")
+        assert yearly["total"] == 1080
+        assert yearly["previous_total"] == 60
+        assert yearly["previous_full_total"] == 760
+        annual_pace = _get(client, "/analytics/cumulative-spend", granularity="yearly")
+        assert annual_pace[2]["current"] == yearly["total"]
+        assert annual_pace[2]["previous1"] == yearly["previous_total"]
+        clock(date(2025, 7, 3))
+        stale = _get(client, "/analytics/overview")
+        assert stale["period_start"] == "2025-07-01"
+        assert stale["last_transaction_date"] == "2024-12-01"
+        assert stale["month_spend"] == stale["month_income"] == 0
+
+
+@pytest.mark.parametrize("today,previous_end", [
+    (date(2024, 3, 30), date(2024, 2, 29)),
+    (date(2024, 2, 29), date(2024, 1, 31)),
+    (date(2025, 1, 15), date(2024, 12, 15)),
+])
+def test_comparable_month_boundaries(today, previous_end):
+    assert comparable_periods(today, "monthly")[3] == previous_end
+
+
+def test_leap_day_year_comparison():
+    assert comparable_periods(date(2024, 2, 29), "yearly")[3] == date(2023, 2, 28)
+
+
+def test_linked_refund_tracks_purchase_category_and_manual_refund_override(clock):
+    ids = _seed([
+        ("purchase", "card", date(2024, 3, 5), 120, "FOOD_AND_DRINK", False),
+        ("refund", "card", date(2024, 3, 10), -120, "GENERAL_MERCHANDISE", False),
+    ])
+    with SessionLocal() as db:
+        db.add(TransactionAnnotation(transaction_id=ids["purchase"], user_category="FOOD/DINING"))
+        db.add(TransactionAnnotation(transaction_id=ids["refund"], refund_status="confirmed",
+                                     refund_match_transaction_id=ids["purchase"]))
+        db.commit()
+    with TestClient(app) as client:
+        for category in ["FOOD/DINING", "TRAVEL/MEALS"]:
+            assert client.patch(f"/transactions/{ids['purchase']}/annotation", headers=AUTH_HEADERS,
+                                json={"user_category": category}).status_code == 200
+            rows = _get(client, "/transactions", q=f"is:spend category:{category}")["items"]
+            assert {row["id"] for row in rows} == set(ids.values())
+            refund = next(row for row in rows if row["id"] == ids["refund"])
+            assert refund["category_source"] == "refund"
+            assert _get(client, "/analytics/category-spend") == [{"category": category, "spend": 0}]
+            with engine.connect() as conn:
+                assert conn.execute(text("SELECT effective_category FROM effective_transactions WHERE id=:id"),
+                                    {"id": ids["refund"]}).scalar_one() == category
+        assert client.patch(f"/transactions/{ids['refund']}/annotation", headers=AUTH_HEADERS,
+                            json={"user_category": "OTHER/REFUNDS"}).status_code == 200
+        refund = next(row for row in _get(client, "/transactions")["items"] if row["id"] == ids["refund"])
+        assert refund["effective_category"] == "OTHER/REFUNDS"
+        assert refund["category_source"] == "manual"
+
+
+def test_refund_only_category_does_not_inflate_sankey_total(clock):
+    ids = _seed([
+        ("food", "card", date(2024, 3, 5), 100, "FOOD_AND_DRINK", False),
+        ("refund", "card", date(2024, 3, 10), -40, "GENERAL_MERCHANDISE", False),
+    ])
+    with SessionLocal() as db:
+        db.add(TransactionAnnotation(transaction_id=ids["refund"], refund_status="confirmed"))
