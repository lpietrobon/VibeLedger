+
+def test_unpair_reclassifies_previously_hidden_refund_immediately(clock):
+    ids = _seed([
+        ("shop purchase", "card", date(2024, 2, 20), 50, "GENERAL_MERCHANDISE", False),
+        ("shop refund", "card", date(2024, 3, 1), -50, "GENERAL_MERCHANDISE", False),
+        ("unrelated", "checking", date(2024, 3, 1), 50, "GENERAL_MERCHANDISE", False),
+    ])
+    with SessionLocal() as db:
+        # Detector's exact merchant evidence is distinct from the provider IDs.
+        for name in ("shop purchase", "shop refund"):
+            db.get(Transaction, ids[name]).name = "SHOP"
+        db.commit()
+    with TestClient(app) as client:
+        pair = client.post("/transfers", headers=AUTH_HEADERS,
+                           json={"txn_a_id": ids["shop refund"], "txn_b_id": ids["unrelated"]})
+        assert pair.status_code == 200
+        assert client.delete(f"/transfers/{pair.json()['id']}", headers=AUTH_HEADERS).status_code == 200
+        march = _get(client, "/analytics/cashflow-trend", start_date="2024-03-01")[0]
+        assert march["expenses"] == march["income"] == 0
+        refund = next(row for row in _get(client, "/transactions")["items"] if row["id"] == ids["shop refund"])
+        assert refund["refund_status"] == "likely"
