diff --git a/docs/finance-intelligence-roadmap.md b/docs/finance-intelligence-roadmap.md
index 447b87b27ea9dc90276cc4912f2e20e86566e825..75fd98cd568947f96beb4ccbdd37dde5372e93a1 100644
