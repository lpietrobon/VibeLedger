+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { renderToStaticMarkup } from "react-dom/server";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { AnnotationSheet } from "./AnnotationSheet";
+import { TransactionRow } from "./TransactionRow";
+import { CategoryComparison } from "./CategoryComparison";
+import { canRenderSankey } from "./charts/SankeyChart";
+import type { CashflowSankey, Transaction } from "@/lib/api/types";
+import { invalidateLedger } from "@/lib/api/cache";
+
+const transaction: Transaction = {
+  id: 1, date: "2026-03-10", amount: 120, name: "Dining", pending: false,
+  effective_category: "FOOD/DINING", category_source: "plaid", annotation: { reviewed: false },
+};
+let root: Root | undefined;
+let container: HTMLDivElement;
+let client: QueryClient;
+beforeEach(() => {
+  vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+  container = document.createElement("div");
+  document.body.appendChild(container);
+  client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  vi.stubGlobal("fetch", vi.fn(async () => ({ ok: true, json: async () => ({ items: [] }) })));
+});
+afterEach(async () => {
+  if (root) await act(async () => root!.unmount());
+  root = undefined;
+  client.clear();
+  container.remove();
+  vi.unstubAllGlobals();
+});
+
+it("keeps a failed correction open with an actionable error, then permits retry", async () => {
+  const close = vi.fn();
+  const save = vi.fn().mockRejectedValueOnce(new Error("Save failed: network unavailable")).mockResolvedValueOnce(undefined);
+  root = createRoot(container);
+  await act(async () => root!.render(
+    <QueryClientProvider client={client}>
+      <AnnotationSheet tx={transaction} onClose={close} onSave={save} />
+    </QueryClientProvider>,
+  ));
+  const saveButton = () => [...container.querySelectorAll("button")].find((b) => b.textContent === "Save")!;
+  await act(async () => saveButton().click());
+  expect(close).not.toHaveBeenCalled();
+  expect(container.querySelector('[role="alert"]')?.textContent).toContain("network unavailable");
+  await act(async () => saveButton().click());
+  expect(save).toHaveBeenCalledTimes(2);
+  expect(close).toHaveBeenCalledTimes(1);
+});
+
+it("differentiates tentative transfer evidence from excluded confirmed movements", () => {
+  const candidate = renderToStaticMarkup(<TransactionRow tx={{ ...transaction, is_transfer_candidate: true }} />);
+  expect(candidate).toContain("Possible transfer · counted");
+  expect(candidate).not.toContain("Transfer · excluded");
+  const confirmed = renderToStaticMarkup(<TransactionRow tx={{ ...transaction, is_transfer: true }} />);
+  expect(confirmed).toContain("Transfer · excluded");
+  expect(confirmed).not.toContain("Possible transfer");
+});
+
+it("invalidates previously cached charts and review counts after a ledger correction", async () => {
+  const keys = [["overview"], ["cashflow"], ["spending-summary", "yearly"], ["comparison"], ["recurring"], ["all-tx"], ["transfers"]];
+  for (const key of keys) client.setQueryData(key, { previous: true });
+  await invalidateLedger(client);
+  for (const key of keys) expect(client.getQueryState(key)?.isInvalidated).toBe(true);
+});
+
+it("displays negative refund-category totals without invalid CSS widths", () => {
+  const markup = renderToStaticMarkup(<CategoryComparison data={[{ category: "SHOPPING", current: -40, previous: 100 }]} />);
+  expect(markup).toContain("-$40");
+  expect(markup).not.toContain("width:-");
+});
+
+describe("Sankey reconciliation", () => {
+  const base: CashflowSankey = {
+    income: 1000, totalSpend: 100, savings: 900, deficit: 0,
+    incomeSources: [{ category: "Salary", amount: 1000 }],
+    buckets: [{ bucket: "FOOD", amount: 100, categories: [{ category: "FOOD/DINING", amount: 100 }] }],
+  };
+  it("allows a conserved positive flow", () => expect(canRenderSankey(base)).toBe(true));
+  it("rejects omitted net-negative buckets instead of inventing extra income", () => {
+    expect(canRenderSankey({ ...base, totalSpend: 60, savings: 940 })).toBe(false);
+  });
+  it("rejects an expanded bucket whose refund category would be hidden", () => {
+    expect(canRenderSankey({ ...base, buckets: [{ bucket: "FOOD", amount: 100, categories: [{ category: "FOOD/DINING", amount: 140 }] }] })).toBe(false);
+  });
+});
+
+it("explains that sorting a truncated drilldown covers loaded rows only", async () => {
+  const { transactionLimitNotice } = await import("@/routes/transactions");
+  expect(transactionLimitNotice(500, 800)).toContain("500 most recent of 800");
+  expect(transactionLimitNotice(500, 800)).toContain("Sorting applies to loaded rows");
+  expect(transactionLimitNotice(40, 40)).toBeNull();
+});
