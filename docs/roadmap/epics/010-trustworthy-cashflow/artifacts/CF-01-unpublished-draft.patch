+"""Exercise real Streamlit reads against the same ledger/API accounting contract."""
+from datetime import date
+
+import pandas as pd
+import pytest
+from fastapi.testclient import TestClient
+
+from app.db.session import SessionLocal, engine
+from app.main import app
+from app.models.models import Account, Item, Transaction, TransactionAnnotation, TransferPair
+from app.services.accounting import comparable_periods
+from dashboard_lib import (
+    add_cashflow_columns,
+    apply_date_filter,
+    apply_scope_filters,
+    load_transactions,
+    spend_transactions,
+    spending_period_summary,
+)
+from tests.conftest import AUTH_HEADERS
+
+
+def _seed():
+    with SessionLocal() as db:
+        item = Item(plaid_item_id="dashboard-item", access_token_encrypted="unused", status="active")
+        db.add(item)
+        db.flush()
+        accounts = [Account(plaid_account_id=f"dashboard-account-{i}", item_id=item.id, name=f"Account {i}", type="depository") for i in range(3)]
+        db.add_all(accounts)
+        db.flush()
+        rows = []
+        for index, (amount, account, pending) in enumerate([
+            (120, 0, False), (-40, 0, False), (-1000, 0, False),
+            (500, 0, False), (-500, 1, False),
+            (70, 1, False), (-70, 2, False),
+            (2000, 0, True), (-5000, 0, True),
+        ]):
+            row = Transaction(plaid_transaction_id=f"dashboard-tx-{index}", item_id=item.id,
+                              account_id=accounts[account].id, date=date(2026, 3, 10),
+                              amount=amount, name=f"Transaction {index}", pending=pending,
+                              plaid_category_primary="FOOD_AND_DRINK")
+            db.add(row)
+            db.flush()
+            rows.append(row)
+        db.add(TransactionAnnotation(transaction_id=rows[1].id, refund_status="confirmed", refund_match_transaction_id=rows[0].id))
+        db.add(TransferPair(txn_out_id=rows[3].id, txn_in_id=rows[4].id, confirmed=True, detected_by="manual"))
+        db.add(TransferPair(txn_out_id=rows[5].id, txn_in_id=rows[6].id, confirmed=False, detected_by="auto"))
+        db.commit()
+
+
+def test_streamlit_scope_matches_api_with_pending_refunds_and_candidate_pairs():
+    _seed()
+    with TestClient(app) as client:
+        load_transactions.clear()
+        frame = load_transactions(engine.url.database)
+        assert frame.loc[frame["is_transfer"], "amount"].tolist() == [500, -500]
+        assert frame.loc[frame["is_transfer_candidate"], "amount"].tolist() == [70, -70]
+        scoped = apply_scope_filters(frame, [], exclude_transfers=True)
+        cashflow = add_cashflow_columns(scoped)
+        spending = spend_transactions(scoped)
+        api = client.get("/analytics/cashflow-trend", headers=AUTH_HEADERS).json()[0]
+        assert cashflow["expense"].sum() == api["expenses"] == 150
+        assert cashflow["income"].sum() == api["income"] == 1070
+        assert spending["amount"].sum() == 150
+        assert not spending["pending"].any()
+        assert -40 in spending["amount"].tolist()
+        assert 70 in spending["amount"].tolist()  # uncertain outflow remains counted
+        drilldown = client.get("/transactions", params={"q": "is:spend"}, headers=AUTH_HEADERS).json()
+        assert set(spending.id) == {row["id"] for row in drilldown["items"]}
+        assert frame["expense_amount"].sum() == 150
+    load_transactions.clear()
+
+
+@pytest.mark.parametrize("today,granularity,prior_end", [
+    (date(2026, 2, 28), "monthly", date(2026, 1, 31)),
+    (date(2026, 3, 31), "monthly", date(2026, 2, 28)),
+    (date(2024, 3, 1), "yearly", date(2023, 3, 1)),
+    (date(2024, 2, 29), "yearly", date(2023, 2, 28)),
+])
+def test_dashboard_uses_shared_comparison_boundaries(today, granularity, prior_end):
+    _, _, start, end, _ = comparable_periods(today, granularity)
+    assert end == prior_end
+    frame = pd.DataFrame([{"date": prior_end, "amount": 100}, {"date": prior_end + pd.Timedelta(days=1), "amount": 999}])
+    assert apply_date_filter(frame, start, end)["amount"].sum() == 100
+
+
+def test_negative_prior_spend_does_not_reverse_growth_direction():
+    current = pd.DataFrame([{"amount": 50, "effective_category": "FOOD"}])
+    previous = pd.DataFrame([{"amount": -100, "effective_category": "FOOD"}])
+    summary = spending_period_summary(current, previous, elapsed_days=31, total_days=31)
+    assert summary["change"] == 150
+    assert summary["change_pct"] == 150
