## 5. The `scan` script

Purpose: walk `epics/**/*.md`, parse frontmatter, produce two generated files.
Never hand-edited, always safe to regenerate, so it's not a merge-conflict source.

**Node.js sketch** (use `gray-matter` for frontmatter parsing, zero other deps):

```js
#!/usr/bin/env node
// roadmap/scan.js
const fs = require('fs');
const path = require('path');
const matter = require('gray-matter');

const ROOT = __dirname;
const EPICS_DIR = path.join(ROOT, 'epics');

function walk(dir, ext, out = []) {
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) walk(full, ext, out);
    else if (entry.name.endsWith(ext) && !entry.name.startsWith('_registry')
             && !entry.name.startsWith('_blocked')) out.push(full);
  }
  return out;
}

function loadAll() {
  const epics = walk(EPICS_DIR, '_epic.md').map(f => ({ file: f, ...matter.read(f).data }));
  const tasks = walk(EPICS_DIR, '.md')
    .filter(f => !f.endsWith('_epic.md'))
    .map(f => ({ file: f, ...matter.read(f).data }));
  return { epics, tasks };
}

function buildRegistry(epics, tasks) {
  const lines = [
    '# Registry (generated — do not edit by hand)',
    `_Last scan: ${new Date().toISOString()}_`,
    '',
    '## Epics',
    '| id | title | status | rev | owner |',
    '|---|---|---|---|---|',
    ...epics.map(e => `| ${e.id} | ${e.title} | ${e.status} | ${e.revision} | ${e.owner || ''} |`),
    '',
    '## Tasks',
    '| id | epic | status | deps | assigned | title |',
    '|---|---|---|---|---|---|',
    ...tasks.map(t =>
      `| ${t.id} | ${t.epic} | ${t.status} | ${(t.dependencies||[]).join(',')} | ${t.assigned_agent||''} | ${t.title} |`
    ),
  ];
  return lines.join('\n');
}

function buildBlockedReport(tasks) {
  const byId = Object.fromEntries(tasks.map(t => [t.id, t]));
  const issues = [];

  for (const t of tasks) {
    for (const dep of (t.dependencies || [])) {
      const d = byId[dep];
      if (!d) issues.push(`${t.id}: depends on unknown task ${dep}`);
      else if (d.status === 'superseded')
        issues.push(`${t.id}: depends on superseded task ${dep} (-> ${d.superseded_by || 'nothing'})`);
      else if (d.status !== 'done' && t.status === 'in-progress')
        issues.push(`${t.id}: marked in-progress but dependency ${dep} is not done`);
    }
  }
  // basic cycle check
  const visiting = new Set(), visited = new Set();
  function hasCycle(id, chain = []) {
    if (visiting.has(id)) { issues.push(`Cycle: ${[...chain, id].join(' -> ')}`); return; }
    if (visited.has(id) || !byId[id]) return;
    visiting.add(id);
    for (const dep of (byId[id].dependencies || [])) hasCycle(dep, [...chain, id]);
    visiting.delete(id); visited.add(id);
  }
  tasks.forEach(t => hasCycle(t.id));

  return ['# Blocked / Issues (generated)', '', ...(issues.length ? issues.map(i => `- ${i}`) : ['None.'])].join('\n');
}

const { epics, tasks } = loadAll();
fs.writeFileSync(path.join(ROOT, '_registry.md'), buildRegistry(epics, tasks));
fs.writeFileSync(path.join(ROOT, '_blocked.md'), buildBlockedReport(tasks));
console.log(`Scanned ${epics.length} epics, ${tasks.length} tasks.`);
```

Have the coding agent adapt this to Python (`python-frontmatter` package) if that's
the stack — same structure applies.

**Run it:**
- As a git pre-commit hook (regenerate before every commit touching `roadmap/`).
- Or as a step the coordinator agent runs at the start of every session before
  deciding what to hand off.

